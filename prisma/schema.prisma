// Kovok Construction Procurement — Production Foundation Schema
// Database: PostgreSQL 16+
// Design Invariant: Workspace-isolated, Transaction-local RLS, Split Allocations, Immutability via Checksum

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. WORKSPACE & TENANT ISOLATION
// -----------------------------------------------------------------------------

model Workspace {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(128)
  businessType String   @db.VarChar(128) // 'Contractor / Builder', 'Material dealer', etc.
  serviceArea  String   @db.VarChar(255) // 'Delhi NCR', 'Gurugram', etc.
  isSandbox    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  memberships      WorkspaceMembership[]
  roles            WorkspaceRole[]
  sites            ProjectSite[]
  ruleProfiles     WorkspaceRuleProfile[]
  approvals        Approval[]
  allocations      ApprovalAllocation[]
  purchaseOrders   PurchaseOrder[]
  auditLogs        AuditLog[]
  sessions         Session[]
  requests         ProcurementRequest[]
  requestCounter   WorkspaceRequestCounter?

  @@map("workspaces")
}

model ProjectSite {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @db.Uuid
  siteName               String    @db.VarChar(255)
  pinCode                String    @db.VarChar(6)
  city                   String    @db.VarChar(128)
  address                String    @db.Text
  contactName            String?   @db.VarChar(128)
  contactPhone           String?   @db.VarChar(32)
  gateTimings            String?   @db.VarChar(128)
  unloadingRestrictions String?   @db.Text
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requests  ProcurementRequest[]

  @@unique([workspaceId, id])
  @@index([workspaceId, pinCode])
  @@map("project_sites")
}

// -----------------------------------------------------------------------------
// 2. USERS, ROLES & PERMISSIONS
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  phone        String?  @db.VarChar(32)
  status       String   @default("ACTIVE") @db.VarChar(32) // 'ACTIVE', 'SUSPENDED'
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  memberships         WorkspaceMembership[]
  sessions            Session[]
  approvedApprovals   Approval[]
  auditLogs           AuditLog[]
  procurementRequests ProcurementRequest[]
  importBatches       ImportBatch[]

  @@map("users")
}

model WorkspaceRole {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @db.Uuid
  name                String   @db.VarChar(64) // 'OWNER', 'BUYER', 'APPROVER', 'SITE_ENGINEER', 'VIEWER'
  description         String?  @db.Text
  approvalLimitAmount Decimal? @db.Decimal(14, 2)
  canCreateRequests   Boolean  @default(true)
  canApproveQuotes    Boolean  @default(false)
  canManageSettings   Boolean  @default(false)
  canRecordReceipts   Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]

  @@unique([workspaceId, name])
  @@map("workspace_roles")
}

model WorkspaceMembership {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_memberships")
}

// -----------------------------------------------------------------------------
// 3. SERVER-SIDE SESSION AUTHENTICATION
// -----------------------------------------------------------------------------

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  workspaceId  String    @db.Uuid
  sessionToken String    @unique @db.VarChar(255)
  expiresAt    DateTime  @db.Timestamptz(6)
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.Text
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId, workspaceId])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 4. WORKSPACE PROCUREMENT RULES
// -----------------------------------------------------------------------------

model WorkspaceRuleProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @db.Uuid
  categories           Json     // Array of category strings e.g. ["TMT Steel", "Cement"]
  requestSource        String   @db.VarChar(128)
  sourcingStrategy     String   @db.VarChar(128)
  competitiveThreshold Decimal  @default(50000.00) @db.Decimal(14, 2)
  maxVendorsPerRfq     Int      @default(3)
  callWindowStart      String   @default("10:00") @db.VarChar(8)
  callWindowEnd        String   @default("18:00") @db.VarChar(8)
  callLanguage         String   @default("hi-IN") @db.VarChar(16)
  maxRetries           Int      @default(2)
  autoRetryUnanswered  Boolean  @default(true)
  autoClarifyMissing   Boolean  @default(true)
  allowSubstitutions   Boolean  @default(false)
  status               String   @default("ACTIVE") @db.VarChar(32)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_rule_profiles")
}

// -----------------------------------------------------------------------------
// 5. DYNAMIC TAX RULES (GST Rationalisation Support)
// -----------------------------------------------------------------------------

model TaxRateRule {
  id             String    @id @default(uuid()) @db.Uuid
  hsnSacCode     String    @db.VarChar(16) // '7214' (Steel), '2523' (Cement)
  description    String    @db.VarChar(255)
  cgstRate       Decimal   @db.Decimal(5, 2)
  sgstRate       Decimal   @db.Decimal(5, 2)
  igstRate       Decimal   @db.Decimal(5, 2)
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date // NULL = currently active
  sourceCitation String    @db.Text
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([hsnSacCode, effectiveFrom])
  @@map("tax_rate_rules")
}

// -----------------------------------------------------------------------------
// 6. APPROVALS, SPLIT ALLOCATIONS & ORDERS
// -----------------------------------------------------------------------------

model Approval {
  id                     String   @id @default(uuid()) @db.Uuid
  workspaceId            String   @db.Uuid
  requestCode            String   @db.VarChar(64) // e.g. KOV-1028
  approvedByUserId       String   @db.Uuid
  totalApprovedQuantity  Decimal  @db.Decimal(12, 3)
  quantityUnit           String   @db.VarChar(32) // 'tonnes', 'bags'
  totalApprovedAmount    Decimal  @db.Decimal(14, 2)
  approvedSpecifications Json     // Preserved specification parameters
  approvalStatus         String   @default("APPROVED") @db.VarChar(32) // 'APPROVED', 'SUPERSEDED', 'CANCELLED'
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approver   User                 @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  allocations ApprovalAllocation[]

  @@index([workspaceId, requestCode])
  @@map("approvals")
}

model ApprovalAllocation {
  id                     String   @id @default(uuid()) @db.Uuid
  approvalId             String   @db.Uuid
  workspaceId            String   @db.Uuid
  quotationReference     String   @db.VarChar(64)
  supplierName           String   @db.VarChar(255)
  allocatedQuantity      Decimal  @db.Decimal(12, 3)
  allocatedPayableAmount Decimal  @db.Decimal(14, 2)
  allocatedTermsSnapshot Json     // Full line-item breakdown snapshot
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  approval      Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder?

  @@index([workspaceId, approvalId])
  @@map("approval_allocations")
}

model PurchaseOrder {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @db.Uuid
  poNumber             String   @db.VarChar(64) // e.g. PO-0261
  approvalAllocationId String   @unique @db.Uuid // Exactly one PO per allocation (supports split orders)
  idempotencyKey       String   @db.VarChar(128)
  approvedTermsSnapshot Json    // Canonical approved terms snapshot
  consistencyChecksum  String   @db.VarChar(64) // SHA-256 consistency checksum of approvedTermsSnapshot
  poStatus             String   @default("CONFIRMED") @db.VarChar(32) // 'CONFIRMED', 'DISPATCHED', 'ARRIVED', 'INSPECTED', 'RECONCILED'
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  allocation ApprovalAllocation @relation(fields: [approvalAllocationId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, poNumber])
  @@unique([workspaceId, idempotencyKey])
  @@map("purchase_orders")
}

// -----------------------------------------------------------------------------
// 7. IMMUTABLE AUDIT LOGS
// -----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  actorId       String?  @db.Uuid
  action        String   @db.VarChar(64) // 'LOGIN', 'WORKSPACE_CREATED', 'APPROVAL_GRANTED', 'ORDER_CREATED'
  entityType    String   @db.VarChar(64)
  entityId      String   @db.VarChar(128)
  payloadBefore Json?
  payloadAfter  Json?
  clientIp      String?  @db.VarChar(64)
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// PHASE 2: RESEARCH-BACKED CONSTRUCTION CATALOGUE & PROCUREMENT INTAKE
// =============================================================================

// -----------------------------------------------------------------------------
// 8. MATERIAL TAXONOMY & STATUTORY STANDARDS
// -----------------------------------------------------------------------------

model MaterialCategory {
  id               String   @id @db.VarChar(64) // e.g. 'CAT-TMT-STEEL', 'CAT-CEMENT'
  categoryName     String   @db.VarChar(128)
  parentCategoryId String?  @db.VarChar(64)
  taxonomyVersion  String   @default("2.0") @db.VarChar(32)
  isActive         Boolean  @default(true)
  researchStatus   String   @default("fully_researched_p0") @db.VarChar(64)
  description      String?  @db.Text
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  parentCategory      MaterialCategory?    @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories     MaterialCategory[]   @relation("CategoryHierarchy")
  standards           StandardsRegistry[]
  canonicalProducts   CanonicalProduct[]
  procurementRequests ProcurementRequest[]

  @@map("material_categories")
}

model StandardsRegistry {
  id                    String    @id @db.VarChar(64) // e.g. 'STD-BIS-IS-1786-2008'
  standardNumber        String    @db.VarChar(64)
  standardTitle         String    @db.Text
  publishingBody        String    @default("Bureau of Indian Standards (BIS)") @db.VarChar(128)
  editionYear           String    @db.VarChar(32)
  amendmentStatus       String    @db.VarChar(128)
  supersedes            String?   @db.VarChar(128)
  mandatoryStatus       String    @db.VarChar(128)
  categoryId            String    @db.VarChar(64)
  scopeSummary          String?   @db.Text
  verificationSourceUrl String?   @db.Text
  lastCheckedDate       DateTime? @db.Date
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)

  category MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("standards_registry")
}

// -----------------------------------------------------------------------------
// 9. CANONICAL PRODUCTS & SPECIFICATIONS
// -----------------------------------------------------------------------------

model CanonicalProduct {
  id                    String   @id @db.VarChar(64) // e.g. 'CP-TMT-500D-12MM'
  categoryId            String   @db.VarChar(64)
  subcategoryId         String?  @db.VarChar(64)
  canonicalName         String   @db.VarChar(255)
  standardProductType   String   @db.VarChar(128)
  technicalDescription  String?  @db.Text
  applicableStandard    String   @db.VarChar(128)
  standardEditionStatus String   @db.VarChar(128)
  primaryUom            String   @db.VarChar(32)
  allowedUoms           Json
  mandatoryAttributes   Json
  conversionFactors     Json
  sourceEvidence        String?  @db.Text
  verificationStatus    String   @default("verified_standard_spec") @db.VarChar(64) // 'verified_standard_spec' vs 'provisional_reference_spec'
  notes                 String?  @db.Text
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  category            MaterialCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants            ProductVariant[]
  listings            SupplierListing[]
  images              ProductImage[]
  procurementRequests ProcurementRequest[]

  @@index([categoryId, verificationStatus])
  @@map("canonical_products")
}

model Manufacturer {
  id                  String   @id @db.VarChar(64) // e.g. 'MFG-JSW-STEEL'
  manufacturerName    String   @db.VarChar(255)
  corporateEntityName String   @db.VarChar(255)
  brandNames          Json
  headquarters        String   @db.VarChar(128)
  primaryCategories   Json
  establishedYear     String?  @db.VarChar(16)
  ownershipType       String   @db.VarChar(128)
  corporateWebsite    String?  @db.Text
  sourceEvidence      String?  @db.Text
  verificationStatus  String   @default("verified") @db.VarChar(64)
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  variants ProductVariant[]

  @@map("manufacturers")
}

model ProductVariant {
  id                      String    @id @db.VarChar(64) // e.g. 'VAR-JSW-NEO-500D-12MM'
  canonicalProductId      String    @db.VarChar(64)
  manufacturerId          String    @db.VarChar(64)
  brandName               String    @db.VarChar(128)
  variantName             String    @db.VarChar(255)
  kovokVariantCode        String    @db.VarChar(64)
  manufacturerProductCode String?   @db.VarChar(64)
  gradeDesignation        String    @db.VarChar(64)
  diameterOrPackSize      String    @db.VarChar(64)
  packagingUom            String    @db.VarChar(32)
  technicalSpecifications Json?
  applicableStandard      String    @db.VarChar(128)
  exactSourceUrl          String?   @db.Text
  datasheetUrl            String?   @db.Text
  verificationStatus      String    @default("unverified") @db.VarChar(64) // 'blocked', 'unverified', 'candidate', 'candidate_partially_verified'
  specVerificationStatus  String?   @db.VarChar(64)
  sourceHttpStatus        String?   @db.VarChar(64)
  unresolvedConflicts     String?   @db.Text
  lastCheckedDate         DateTime? @db.Date
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)

  canonicalProduct CanonicalProduct  @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict)
  manufacturer     Manufacturer      @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  listings         SupplierListing[]
  images           ProductImage[]

  @@index([canonicalProductId, verificationStatus])
  @@index([manufacturerId])
  @@map("product_variants")
}

model TechnicalSpecification {
  id                     String   @id @db.VarChar(64) // e.g. 'SPEC-TMT-500D-YS-MIN'
  variantIdOrCanonicalId String   @db.VarChar(64)
  entityLevel            String   @db.VarChar(32) // 'canonical', 'variant'
  attributeName          String   @db.VarChar(128)
  attributeValue         String   @db.VarChar(128)
  attributeUnit          String?  @db.VarChar(32)
  specificationCategory  String   @db.VarChar(64)
  originType             String   @db.VarChar(64)
  sourceId               String?  @db.VarChar(64)
  evidenceLocation       String?  @db.Text
  verificationStatus     String   @default("verified") @db.VarChar(64)
  conflictsFlagged       String?  @db.Text
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  @@index([variantIdOrCanonicalId, entityLevel])
  @@map("technical_specifications")
}

// -----------------------------------------------------------------------------
// 10. SOURCES, EVIDENCE & AUDIT TRAIL
// -----------------------------------------------------------------------------

model SourceRegistry {
  id                    String    @id @db.VarChar(64) // e.g. 'SRC-BIS-OFFICIAL'
  organizationName      String    @db.VarChar(255)
  sourceTier            String    @db.VarChar(32)
  sourceType            String    @db.VarChar(64)
  sourceUrl             String    @db.Text
  ownerOrPublisher      String?   @db.VarChar(255)
  categoryCoverage      String?   @db.VarChar(255)
  tlsVerificationStatus String    @db.VarChar(64)
  httpStatusCode        Int?
  accessMethod          String    @db.VarChar(64)
  dataReuseStatus       String    @db.VarChar(64)
  retrievalDate         DateTime? @db.Date
  reviewerNotes         String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)

  evidenceRecords SourceEvidenceRecord[]

  @@map("source_registry")
}

model SourceEvidenceRecord {
  id                         String    @id @db.VarChar(64) // e.g. 'EVD-001'
  variantIdOrCanonicalId     String    @db.VarChar(64)
  sourceId                   String    @db.VarChar(64)
  exactEvidenceUrl           String    @db.Text
  documentTitleOrPage        String?   @db.VarChar(255)
  evidenceType               String    @db.VarChar(64)
  extractedAttributesSummary String?   @db.Text
  evidenceQuoteOrExcerpt     String?   @db.Text
  httpResponseCode           Int?
  retrievalTimestamp         DateTime? @db.Timestamptz(6)
  verificationResult         String    @db.VarChar(64)
  notes                      String?   @db.Text
  createdAt                  DateTime  @default(now()) @db.Timestamptz(6)

  source SourceRegistry @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([variantIdOrCanonicalId])
  @@map("product_evidence")
}

// -----------------------------------------------------------------------------
// 11. SUPPLIER PLATFORM & QUARANTINED MEDIA
// -----------------------------------------------------------------------------

model SupplierOrganization {
  id                     String   @id @db.VarChar(64) // e.g. 'SUP-JSW-ONE'
  organizationName       String   @db.VarChar(255)
  legalEntityName        String   @db.VarChar(255)
  supplierType           String   @db.VarChar(64)
  headquarters           String   @db.VarChar(128)
  serviceGeography       Json
  authorizedPartnerships Json
  supportedCategories    Json
  contactPhone           String?  @db.VarChar(32)
  contactEmail           String?  @db.VarChar(128)
  websiteUrl             String?  @db.Text
  sourceTier             String   @db.VarChar(32)
  verificationStatus     String   @default("verified_organization") @db.VarChar(64)
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  listings SupplierListing[]

  @@map("supplier_organizations")
}

model SupplierListing {
  id                         String    @id @db.VarChar(64) // e.g. 'LST-JSW-ONE-TMT-500D-12MM'
  supplierId                 String    @db.VarChar(64)
  canonicalProductId         String?   @db.VarChar(64)
  variantId                  String?   @db.VarChar(64)
  kovokCandidateSku          String?   @db.VarChar(64)
  supplierProductTitle       String    @db.VarChar(255)
  listingType                String    @db.VarChar(64)
  serviceArea                String    @db.VarChar(128)
  listingUrl                 String?   @db.Text
  sourceId                   String?   @db.VarChar(64)
  listingStatus              String    @default("platform_only") @db.VarChar(64) // 'platform_only', 'platform_only_broken_url'
  priceStockCollectionMethod String    @db.VarChar(64)
  verificationDate           DateTime? @db.Date
  reviewNotes                String?   @db.Text
  createdAt                  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @db.Timestamptz(6)

  supplier         SupplierOrganization @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  canonicalProduct CanonicalProduct?    @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict)
  variant          ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([supplierId, listingStatus])
  @@map("supplier_listings")
}

model ProductImage {
  id                   String   @id @db.VarChar(64) // e.g. 'IMG-TMT-TATA-500D-08MM'
  variantId            String?  @db.VarChar(64)
  canonicalProductId   String?  @db.VarChar(64)
  imageUrl             String   @db.Text
  originalPublisher    String?  @db.VarChar(255)
  assetType            String   @db.VarChar(64)
  imageRole            String   @db.VarChar(64)
  fileFormat           String   @db.VarChar(16)
  dimensionsPx         String?  @db.VarChar(32)
  sha256Hash           String   @db.VarChar(64)
  skuDepictionAccuracy String?  @db.VarChar(64)
  reusePermissionStatus String  @db.VarChar(64)
  displayInProduction  Boolean  @default(false) // 100% quarantined from commercial buyer display
  reviewStatus         String   @default("restricted_pending_review") @db.VarChar(64)
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict)

  @@index([displayInProduction])
  @@map("product_images")
}

model UnresolvedReviewItem {
  id                 String    @id @db.VarChar(64) // e.g. 'UNR-001'
  recordType         String    @db.VarChar(64)
  entityId           String    @db.VarChar(64)
  entityName         String    @db.VarChar(255)
  issueType          String    @db.VarChar(64)
  severity           String    @db.VarChar(32)
  description        String    @db.Text
  conflictingValues  Json?
  missingFields      Json?
  sourceIds          Json?
  suggestedAction    String?   @db.Text
  assignedReviewer   String?   @db.VarChar(128)
  status             String    @db.VarChar(64)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt         DateTime? @db.Timestamptz(6)

  @@index([status, severity])
  @@map("unresolved_records")
}

// -----------------------------------------------------------------------------
// 12. CONTROLLED STAGING IMPORT LINEAGE
// -----------------------------------------------------------------------------

model ImportBatch {
  id                   String    @id @default(uuid()) @db.Uuid
  batchNumber          String    @unique @db.VarChar(64) // e.g. 'BATCH-20261030-01'
  sourceManifestSha256 String    @db.VarChar(64)
  status               String    @default("PENDING") @db.VarChar(32) // PENDING, VALIDATING, VALIDATED, IMPORTING, COMPLETED, FAILED, ROLLING_BACK, ROLLED_BACK
  summary              Json?
  importedByUserId     String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  completedAt          DateTime? @db.Timestamptz(6)

  importedByUser User?               @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  records        ImportBatchRecord[]

  @@map("import_batches")
}

model ImportBatchRecord {
  id             String   @id @default(uuid()) @db.Uuid
  batchId        String   @db.Uuid
  entityType     String   @db.VarChar(64)
  recordId       String   @db.VarChar(64)
  action         String   @db.VarChar(32) // 'INSERT', 'UPDATE'
  snapshotBefore Json?
  snapshotAfter  Json
  isHumanLocked  Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, entityType])
  @@index([entityType, recordId])
  @@map("import_batch_records")
}

// -----------------------------------------------------------------------------
// 13. TENANT PROCUREMENT INTAKE & REQUEST COUNTERS
// -----------------------------------------------------------------------------

model WorkspaceRequestCounter {
  workspaceId String   @id @db.Uuid
  nextCounter Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_request_counters")
}

model ProcurementRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @db.Uuid
  siteId              String   @db.Uuid
  requestCode         String   @db.VarChar(64) // e.g. 'KOV-REQ-0001'
  materialCategoryId  String   @db.VarChar(64)
  canonicalProductId  String?  @db.VarChar(64)
  targetGrade         String?  @db.VarChar(64)
  targetDiameterMm    Decimal? @db.Decimal(5, 2)
  quantityValue       Decimal  @db.Decimal(12, 3)
  quantityUnit        String   @db.VarChar(32) // 'TONNES', 'BAGS', 'PIECES'
  derivedCalculations Json?    // Theoretical mass, pieces, conversion notes
  requestStatus       String   @default("DRAFT") @db.VarChar(32) // 'DRAFT', 'MATCHED_VERIFIED', 'NEEDS_CLARIFICATION', 'CANCELLED'
  clarificationReason String?  @db.Text
  buyerNotes          String?  @db.Text
  createdByUserId     String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site             ProjectSite      @relation(fields: [workspaceId, siteId], references: [workspaceId, id], onDelete: Restrict)
  createdByUser    User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  materialCategory MaterialCategory @relation(fields: [materialCategoryId], references: [id], onDelete: Restrict)
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, requestCode])
  @@index([workspaceId, requestStatus])
  @@index([workspaceId, siteId])
  @@map("procurement_requests")
}
