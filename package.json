{
  "name": "kovok-construction-procurement",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade AI procurement operations platform for Indian construction materials",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/deploy_production_migrations.ts && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:prod": "tsx scripts/deploy_production_migrations.ts",
    "db:seed": "tsx prisma/seed.ts",
    "catalogue:manifest": "tsx scripts/generate_manifest.ts",
    "catalogue:dry-run": "tsx scripts/import_catalogue.ts --dry-run",
    "catalogue:import": "tsx scripts/import_catalogue.ts",
    "catalogue:rollback": "tsx scripts/rollback_catalogue.ts",
    "test": "tsx tests/run-all.ts",
    "test:real-postgres": "tsx --env-file=.env tests/real-postgres-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.66.0",
    "next": "16.2.12",
    "prisma": "6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
