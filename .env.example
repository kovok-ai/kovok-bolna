# ==============================================================================
# Kovok Construction Procurement Platform — Environment Configuration Template
# ==============================================================================
# IMPORTANT: This file contains PLACEHOLDER VALUES ONLY.
# Target Runtime: Node.js 24.x LTS | Framework: Next.js 16.0.x (Active LTS)
# Never commit real credentials, secret keys, or passwords to version control.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Enables visual "SAMPLE DATA" / Sandbox chip in the header when running local fixtures
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Primary connection string (supports connection pooling, e.g. PgBouncer / Supabase)
DATABASE_URL=postgresql://postgres:placeholder_db_password@localhost:5432/kovok_procurement?schema=public&sslmode=prefer

# Direct connection string for running Prisma migrations (bypassing connection poolers)
DIRECT_URL=postgresql://postgres:placeholder_db_password@localhost:5432/kovok_procurement?schema=public

# ------------------------------------------------------------------------------
# 3. ASYNCHRONOUS JOB QUEUE (PostgreSQL-backed by default)
# ------------------------------------------------------------------------------
# Optional: Redis URL for distributed rate-limiting or high-concurrency locks
REDIS_URL=redis://:placeholder_redis_password@localhost:6379/0

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Server-Side Sessions)
# ------------------------------------------------------------------------------
# Secret used for encrypting server-side HttpOnly session cookies (min 32 characters)
SESSION_SECRET=placeholder_session_secret_min_32_characters_random_string

# Optional: JWT Secret reserved exclusively for external machine API clients (if enabled)
MACHINE_API_JWT_SECRET=placeholder_jwt_secret_min_32_characters_random_string

# Password hashing cost parameters (Argon2id)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# ------------------------------------------------------------------------------
# 5. SARVAM AI VOICE AGENT & TELEPHONY
# ------------------------------------------------------------------------------
# Sarvam API credentials (obtain from Sarvam Developer Console)
SARVAM_API_KEY=placeholder_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# High-entropy secret token passed in webhook URL for endpoint authentication
# e.g. POST /api/v1/webhooks/sarvam/events?token=${SARVAM_WEBHOOK_INGESTION_TOKEN}
SARVAM_WEBHOOK_INGESTION_TOKEN=placeholder_high_entropy_secret_webhook_url_token_min_32_chars

# Default Indic LLM & Speech configuration
SARVAM_MODEL=saaras:v1
SARVAM_DEFAULT_LANGUAGE=hi-IN
SARVAM_VOICE_GENDER=female

# Outbound telephony caller ID (Indian E.164 phone number: +91XXXXXXXXXX)
OUTBOUND_CALLER_ID=+910000000000

# Permitted calling window for Indian construction suppliers (IST hours)
CALL_TIMEZONE=Asia/Kolkata
CALL_WINDOW_START_IST=10:00
CALL_WINDOW_END_IST=18:00
MAX_OUTBOUND_CALL_RETRIES=2

# ------------------------------------------------------------------------------
# 6. CLOUD OBJECT STORAGE (Challans, Weighment Slips, Audio Recordings)
# ------------------------------------------------------------------------------
# Provider to be finalized based on cloud selection (AWS S3, GCP GCS, or Azure Blob in India)
STORAGE_PROVIDER=s3-compatible
STORAGE_BUCKET=kovok-procurement-records
STORAGE_REGION=ap-south-1 # e.g. ap-south-1 (Mumbai) / asia-south1 (Mumbai) / centralindia (Pune)
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_ACCESS_KEY=placeholder_storage_access_key
STORAGE_SECRET_KEY=placeholder_storage_secret_key

# ------------------------------------------------------------------------------
# 7. ERPNEXT INTEGRATION (Optional - Connected Procurement Mode)
# ------------------------------------------------------------------------------
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=https://erp.example-contractor.in
ERPNEXT_API_KEY=placeholder_erpnext_api_key
ERPNEXT_API_SECRET=placeholder_erpnext_api_secret

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY, LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=info # 'debug', 'info', 'warn', 'error'
SENTRY_DSN=
